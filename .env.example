# Victor — API keys y opciones. Copiar a ~/.config/victor/victor.env (recomendado,
# fuera del repo) o a <repo>/.env (ignorado por git). También vale exportarlas.
# Todas son opcionales: sin ninguna, Victor funciona en modo local
# (STT faster-whisper en CPU + respuestas deterministas desde la telemetría).
# Se aceptan también los nombres con prefijo NEXUS_ (NEXUS_GROQ_API_KEY, ...).

GROQ_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=
DEEPGRAM_API_KEY=

# Modelos (opcional). Si uno se retira, Victor se autocura eligiendo uno vivo.
# GROQ_MODEL=openai/gpt-oss-120b
# CEREBRAS_MODEL=gpt-oss-120b
# NVIDIA_MODEL=meta/llama-4-maverick-17b-128e-instruct
# GEMINI_MODEL=gemini-flash-latest
# GROQ_STT_MODEL=whisper-large-v3-turbo

# Backend propio OpenAI-compatible (va primero en la cadena si se define):
# CUSTOM_LLM_BASE_URL=https://openrouter.ai/api/v1
# CUSTOM_LLM_MODEL=...
# CUSTOM_LLM_API_KEY=...

# STT local de respaldo (CPU, 0 VRAM): small | base | off
# LOCAL_STT_MODEL=small
# LOCAL_STT_THREADS=4

# Audio ducking: volumen del juego mientras Victor habla (1.0 = desactivado)
# DUCK_LEVEL=0.35
# DUCK_APPS=acs.exe,acs_x86.exe
